      "id": "620d66b7-4ce6-4f9c-a557-7c5075d44a6f",
      "name": "Buscar Leads p/ Validar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        320
      ],
      "credentials": {
        "supabaseApi": {
          "id": "TI9uXqodlyBVC9Se",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Monta UM lote com todos os candidatos a WhatsApp de todos os leads.\n// Cada lead pode ter mais de um celular em telefones_json — validamos\n// todos de uma vez e depois escolhemos o primeiro que existir.\nconst leads = $input.all().map(i => i.json).flat().filter(l => l && l.id);\nif (leads.length === 0) return [{ json: { __vazio: true } }];\n\nconst mapa = [];\nconst todos = new Set();\nfor (const l of leads) {\n  const candidatos = [];\n  // 1º candidato: o whatsapp já escolhido no A0\n  if (l.whatsapp) candidatos.push(String(l.whatsapp));\n  // demais celulares do telefones_json\n  for (const t of (l.telefones_json || [])) {\n    if (t && t.celular && t.area && t.number) {\n      const n = `55${t.area}${t.number}`;\n      if (!candidatos.includes(n)) candidatos.push(n);\n    }\n  }\n  if (candidatos.length === 0) continue;\n  mapa.push({ id: l.id, slug: l.slug, candidatos });\n  candidatos.forEach(c => todos.add(c));\n}\n\nif (todos.size === 0) return [{ json: { __vazio: true } }];\nreturn [{ json: { numbers: Array.from(todos), mapa } }];"
      },
      "id": "0a0deb12-5ae5-41e9-a128-5a33429fda22",
      "name": "Montar Lote de Números",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        320
      ]
    },
