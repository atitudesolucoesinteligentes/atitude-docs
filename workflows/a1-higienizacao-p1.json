      "id": "b42a6022-b9c7-417d-82c7-5dffffb37aa7",
      "name": "Evolution Validar Números",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        224
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "lGhduTvTTMaZoDWT",
          "name": "Evolution apikey"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Cruza o resultado da Evolution com os candidatos de cada lead:\n// o primeiro candidato com exists=true vira o whatsapp oficial.\n// Sem nenhum candidato válido => lead sai do funil (status: sem_whatsapp).\nconst resp = $input.all().map(i => i.json).flat();\nconst existe = new Map();\nfor (const r of resp) {\n  if (!r) continue;\n  const num = String(r.number || r.jid || '').replace(/\\D/g, '');\n  existe.set(num, !!r.exists);\n  // Evolution pode devolver o jid com 8 dígitos (sem o nono) — indexa também\n  if (r.jid) existe.set(String(r.jid).split('@')[0].replace(/\\D/g, ''), !!r.exists);\n}\nconst mapa = $('Montar Lote de Números').first().json.mapa || [];\nconst agora = new Date().toISOString();\nconst out = [];\nfor (const m of mapa) {\n  const valido = m.candidatos.find(c => existe.get(String(c).replace(/\\D/g, '')) === true);\n  out.push({ json: {\n    id: m.id,\n    slug: m.slug,\n    body: valido\n      ? { whatsapp: valido, whatsapp_valido: true,  whatsapp_verificado_em: agora }\n      : {                    whatsapp_valido: false, whatsapp_verificado_em: agora, status: 'sem_whatsapp' }\n  }});\n}\nif (out.length === 0) return [{ json: { __vazio: true } }];\nreturn out;"
      },
