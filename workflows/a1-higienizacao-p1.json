    {
      "parameters": {
        "jsCode": "// Resumo da rodada\nconst aplicados = $('Aplicar Resultado').all().map(i => i.json).filter(j => j.id);\nconst validos = aplicados.filter(a => a.body.whatsapp_valido === true).length;\nconst invalidos = aplicados.length - validos;\nconst higiene = $('Etapa 0 - Higiene Cadastral (RPC)').first()?.json || {};\nreturn [{ json: {\n  processados: aplicados.length,\n  whatsapp_validos: validos,\n  whatsapp_invalidos: invalidos,\n  higiene_cadastral: higiene\n} }];"
      },
