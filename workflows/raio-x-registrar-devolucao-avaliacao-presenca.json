    {
      "parameters": {
        "jsCode": "// ============ VALIDAR TOKEN + PAYLOAD ============\nconst TOKEN_ESPERADO = '16b9aaf079b00de57bd1cf5cfeb5f1b447aa7704e94baaa3';\n\nconst headers = $json.headers || {};\nconst token = headers['x-raiox-token'] || headers['X-Raiox-Token'] || '';\nif (token !== TOKEN_ESPERADO) {\n  throw new Error('Token inválido no header x-raiox-token');\n}\n\nconst b = $json.body || {};\nconst empresaId = Number(b.empresa_id);\nif (!Number.isInteger(empresaId) || empresaId <= 0) {\n  throw new Error('empresa_id obrigatório (inteiro). Lead novo: criar antes via SQL da Etapa 5 da skill.');\n}\n\nconst numero = String(b.numero || '').replace(/\\D/g, '');\nif (!/^55\\d{10,11}$/.test(numero)) {\n  throw new Error('numero obrigatório no formato 55DDDNÚMERO (apenas dígitos): recebido \"' + b.numero + '\"');\n}\n\nconst a = b.achados || {};\nconst placar = a.placar || {};\nconst valoresValidos = ['ok', 'atencao', 'ausente'];\nconst pilaresObrigatorios = ['google_maps', 'site', 'instagram', 'consistencia'];\nfor (const p of pilaresObrigatorios) {\n  if (!valoresValidos.includes(placar[p])) {\n    throw new Error('placar.' + p + ' obrigatório com valor ok|atencao|ausente');\n  }\n}\n\nconst servicosValidos = ['criacao_site', 'redesign_site', 'config_gbp', 'instagram', 'nenhuma'];\nconst recomendacao = a.recomendacao_principal || 'nenhuma';\nif (!servicosValidos.includes(recomendacao)) {\n  throw new Error('recomendacao_principal inválida: ' + recomendacao);\n}\n\n// Coerência: recomendação não pode contradizer pilar ok\nconst mapaPilar = { criacao_site: 'site', redesign_site: 'site', config_gbp: 'google_maps', instagram: 'instagram' };\nif (mapaPilar[recomendacao] && placar[mapaPilar[recomendacao]] === 'ok') {\n  throw new Error('recomendacao_principal \"' + recomendacao + '\" contradiz o pilar \"' + mapaPilar[recomendacao] + '\" = ok');\n}\n\n// Derivar contraindicados do placar se não vierem explícitos\nlet contraindicados = Array.isArray(a.produtos_contraindicados) ? a.produtos_contraindicados : null;\nif (!contraindicados) {\n  contraindicados = [];\n  if (placar.site === 'ok') contraindicados.push('criacao_site', 'redesign_site');\n  if (placar.google_maps === 'ok') contraindicados.push('config_gbp');\n}\n\nconst achados = {\n  versao: 1,\n  avaliado_em: a.avaliado_em || new Date().toISOString().slice(0, 10),\n  placar,\n  pontos_fortes: Array.isArray(a.pontos_fortes) ? a.pontos_fortes.slice(0, 4) : [],\n  custa_cliente: Array.isArray(a.custa_cliente) ? a.custa_cliente.slice(0, 5) : [],\n  gargalo_principal: String(a.gargalo_principal || '').slice(0, 300),\n  recomendacao_principal: recomendacao,\n  produtos_contraindicados: [...new Set(contraindicados)]\n};\n\n// Mensagem de devolução: string ou array de até 2 balões (balão 1 + ponte suave)\nlet baloes = [];\nif (Array.isArray(b.mensagem_devolucao)) baloes = b.mensagem_devolucao.filter(Boolean).map(s => String(s).trim());\nelse if (typeof b.mensagem_devolucao === 'string' && b.mensagem_devolucao.trim()) baloes = [b.mensagem_devolucao.trim()];\nbaloes = baloes.slice(0, 2).map(s => s.slice(0, 1500));\nif (baloes.length === 0) throw new Error('mensagem_devolucao obrigatória (string ou array de até 2 balões)');\n\nconst followupDias = Number.isFinite(Number(b.followup_dias)) ? Math.max(0, Number(b.followup_dias)) : 2;\n\nreturn [{ json: { empresa_id: empresaId, numero, achados, baloes, followup_dias: followupDias } }];"
      },
