    {
      "parameters": {
        "jsCode": "// Normaliza o lead e calcula a recomendação (mesma régua do quiz)\nconst b = $input.first().json.body || $input.first().json;\n\nconst nome = String(b.nome || '').trim().slice(0, 120);\nconst whatsapp = String(b.whatsapp || '').replace(/\\D/g, '');\nconst scores = Array.isArray(b.scores) ? b.scores.map(n => Number(n) || 0) : [];\nconst total = Number(b.total) || scores.reduce((s, n) => s + n, 0);\nconst etapaFraca = String(b.etapaFraca || '');\n\nif (!nome || whatsapp.length < 10) {\n  return [{ json: { valido: false, motivo: 'nome ou whatsapp inválido' } }];\n}\n\n// Régua oficial: <=14 Kit | 15-28 Painel ou Kit | >=29 Gestão Assistida\nlet recomendacao;\nif (total <= 14) recomendacao = 'Kit Gestão na Prática (R$ 97)';\nelse if (total <= 28) recomendacao = 'Painel do Dono (R$ 197/mês)';\nelse recomendacao = 'Gestão Assistida (R$ 1.997/mês)';\n\n// Prioridade travada: Dinheiro abaixo de 3 é sempre prioridade nº 1\nconst etapas = ['Alicerce','Termômetro','Identidade','Trajetória','Unidade de medida','Dinheiro','Engrenagem'];\nconst dinheiroBaixo = scores.length === 7 && scores[5] < 3;\n\n// Link wa.me do lead (assume Brasil se vier sem DDI)\nconst waLead = whatsapp.startsWith('55') ? whatsapp : '55' + whatsapp;\n\nreturn [{\n  json: {\n    valido: true,\n    nome,\n    whatsapp,\n    wa_link: 'https://wa.me/' + waLead,\n    total,\n    scores,\n    etapa_fraca: etapaFraca,\n    dinheiro_alerta: dinheiroBaixo,\n    recomendacao,\n    origem: String(b.origem || 'raiox'),\n    pagina: String(b.pagina || 'diagnostico'),\n    ts: b.ts || new Date().toISOString()\n  }\n}];"
      },
